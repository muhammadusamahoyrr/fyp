# Settings for running the NORMAL backend with the Document Analyzer on, its AI
# step SIMULATED, against a LOCAL database (FYP demo; never deployed).
#
#   1. Copy this file to .env.analyzer-demo.local (git-ignored) and fill in ANALYZER_KEKS.
#   2. Start the normal backend with it:   .\start.ps1 --env-overlay .env.analyzer-demo.local
#
# These values apply to that backend process only; .env is not edited. Everything
# not listed here (JWT secret, other modules' settings) still comes from .env.
#
# The whole application uses this database while it runs -- not only the analyzer --
# because the simulated provider refuses a hosted cluster. It starts EMPTY: register
# your demo lawyer through the normal Sign Up page. Prepare it once with:
#   venv\Scripts\python scripts\dev_mongo_replset.py
#   venv\Scripts\python scripts\prepare_local_database.py --db attorney_ai_local

MONGODB_URL=mongodb://127.0.0.1:27018/?replicaSet=rs0
DB_NAME=attorney_ai_local
# The hosted Redis belongs with the hosted database; a local run uses none.
REDIS_URL=

DOC_ANALYZER=true
# One key, generated once and kept (losing it makes stored analyzer files unreadable):
#   venv\Scripts\python -c "import base64,os;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
ANALYZER_KEKS=
ANALYZER_KEK_ACTIVE=k1

ANALYZER_AI=true
ANALYZER_AI_PROVIDER=simulated
ANALYZER_AI_SYNTHETIC_ONLY=true
ANALYZER_PII_REVIEW_REQUIRED=true
# The supported demo engine (AI report). The drafting-question engine has NOT passed
# its evaluation and stays off.
ANALYZER_ENGINE_HYPOTHESES=false
ANALYZER_HYPOTHESIS_REVIEW_UI=false

# Optional: no e-mail from demo accounts (registration works without it).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
