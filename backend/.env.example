# MongoDB
#
# PLACEHOLDER ONLY - never paste a live connection string into this file.
# It is tracked, so anything written here is public the moment it is pushed,
# and redacting it afterwards does not un-publish it: the value stays in Git
# history, in forks and in clones. A real Atlas URI was committed to this path
# once and had to be rotated.
#
# The real value belongs in `.env`, which is gitignored.
# `backend/tests/test_no_tracked_example_secrets.py` fails the build if a
# credential-bearing URI appears here again.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=attorney_ai

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES encryption for CNIC (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-this-to-a-fernet-key

# LLM — automatic fallback chain is Gemini -> Groq -> OpenRouter.
# Configure at least one key. LLM_PROVIDER=ollama prefers a local Ollama first.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=groq

# ChromaDB (activate when AI work starts)
CHROMA_HOST=chroma
CHROMA_PORT=8001

# Redis — leave empty to run single-worker in-process (current dev default).
# Set to enable cross-worker WS fan-out, scheduler locks, cache/rate-limit
# sharing, and the citator Streams pipeline (needs a 5.0+ / 6.2+ server).
#   local:  redis://localhost:6379/0
#   hosted (TLS, e.g. Upstash — note the double-s scheme):
#           rediss://default:<TOKEN>@<host>.upstash.io:6379
REDIS_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@attorney.ai

# Langfuse monitoring (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins (comma-separated), e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=
# In-process cause-list + POA schedulers. Set false on all but one worker in multi-worker deployments.
RUN_SCHEDULERS=true

# Local English OCR for scanned intake evidence. Requires a local Tesseract
# installation with the `eng` language. OCR text is never analysed until the
# client reviews and confirms it. Keep false unless that runtime is installed.
# Production also requires the identifier of the reviewed benchmark artefact
# which justified activation; this is deliberately blank until one exists.
ENGLISH_OCR_ENABLED=false
ENGLISH_OCR_BENCHMARK_ID=

# Citator ingest streaming (Redis Streams — requires Redis 5.0+, XAUTOCLAIM
# recovery needs 6.2+). Defaults are sensible; override only to tune throughput.
# Streams: judgment.ingest, judgment.embed, judgment.dead · groups: parse, embed
CITATOR_STREAM_MAXLEN=10000
CITATOR_BLOCK_MS=5000
CITATOR_CLAIM_MIN_IDLE_MS=60000
CITATOR_BATCH=10
CITATOR_MAX_DELIVERIES=5

# ── DIY contract builder ──────────────────────────────────────────────────────
# OFF. Parks the client-facing agreement wizard (the NDA / lease / employment
# template gallery and the create flow). Every template was withdrawn pending
# review by a qualified Pakistani lawyer and the server refuses any body still
# carrying the withdrawal notice, so while this is off the builder has no
# success case at all.
#
# Does NOT gate engagement letters: those are created inside engagement_service
# via create_pending_engagement_letter, never through the HTTP route, and they
# gate all billing. Listing, viewing, signing and declining stay available to
# everyone whatever this is set to.
#
# The frontend mirror is NEXT_PUBLIC_AGREEMENTS_DIY_ENABLED. Flip this one
# FIRST. Turning it on requires counsel-reviewed templates, not a deployment.
AGREEMENTS_DIY_BUILDER_ENABLED=false
