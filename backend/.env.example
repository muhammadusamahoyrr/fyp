# MongoDB
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=attorney_ai

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES encryption for CNIC (32-byte base64-encoded key)
ENCRYPTION_KEY=change-this-to-a-fernet-key-run-python-cryptography-fernet-generate-key

# LLM (use one at a time)
GEMINI_API_KEY=
GROQ_API_KEY=<your-groq-api-key>
LLM_PROVIDER=groq

# ChromaDB (activate when AI work starts)
CHROMA_HOST=chroma
CHROMA_PORT=8001

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@attorney.ai

# Langfuse monitoring (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
