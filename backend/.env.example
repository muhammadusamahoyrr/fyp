# MongoDB
#
# PLACEHOLDER ONLY - never paste a live connection string into this file.
# It is tracked, so anything written here is public the moment it is pushed,
# and redacting it afterwards does not un-publish it: the value stays in Git
# history, in forks and in clones. A real Atlas URI was committed to this path
# once and had to be rotated.
#
# The real value belongs in `.env`, which is gitignored.
# `backend/tests/test_no_tracked_example_secrets.py` fails the build if a
# credential-bearing URI appears here again.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=attorney_ai

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES encryption for CNIC (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-this-to-a-fernet-key

# LLM — automatic fallback chain is Gemini -> Groq -> OpenRouter.
# Configure at least one key. LLM_PROVIDER=ollama prefers a local Ollama first.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=groq

# ChromaDB (activate when AI work starts)
CHROMA_HOST=chroma
CHROMA_PORT=8001

# Redis — leave empty to run single-worker in-process (current dev default).
# Set to enable cross-worker WS fan-out, scheduler locks, cache/rate-limit
# sharing, and the citator Streams pipeline (needs a 5.0+ / 6.2+ server).
#   local:  redis://localhost:6379/0
#   hosted (TLS, e.g. Upstash — note the double-s scheme):
#           rediss://default:<TOKEN>@<host>.upstash.io:6379
REDIS_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@attorney.ai

# Langfuse monitoring (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins (comma-separated), e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=
# In-process cause-list + POA schedulers. Set false on all but one worker in multi-worker deployments.
RUN_SCHEDULERS=true

# Local English OCR for scanned intake evidence. Requires a local Tesseract
# installation with the `eng` language. OCR text is never analysed until the
# client reviews and confirms it. Keep false unless that runtime is installed.
# Production also requires the identifier of the reviewed benchmark artefact
# which justified activation; this is deliberately blank until one exists.
ENGLISH_OCR_ENABLED=false
ENGLISH_OCR_BENCHMARK_ID=

# Citator ingest streaming (Redis Streams — requires Redis 5.0+, XAUTOCLAIM
# recovery needs 6.2+). Defaults are sensible; override only to tune throughput.
# Streams: judgment.ingest, judgment.embed, judgment.dead · groups: parse, embed
CITATOR_STREAM_MAXLEN=10000
CITATOR_BLOCK_MS=5000
CITATOR_CLAIM_MIN_IDLE_MS=60000
CITATOR_BATCH=10
CITATOR_MAX_DELIVERIES=5

# ── DIY contract builder ──────────────────────────────────────────────────────
# OFF. Parks the client-facing agreement wizard (the NDA / lease / employment
# template gallery and the create flow). Every template was withdrawn pending
# review by a qualified Pakistani lawyer and the server refuses any body still
# carrying the withdrawal notice, so while this is off the builder has no
# success case at all.
#
# Does NOT gate engagement letters: those are created inside engagement_service
# via create_pending_engagement_letter, never through the HTTP route, and they
# gate all billing. Listing, viewing, signing and declining stay available to
# everyone whatever this is set to.
#
# The frontend mirror is NEXT_PUBLIC_AGREEMENTS_DIY_ENABLED. Flip this one
# FIRST. Turning it on requires counsel-reviewed templates, not a deployment.
AGREEMENTS_DIY_BUILDER_ENABLED=false

# ── Trusted reverse proxies (decision D8) ─────────────────────────────────────
# EMPTY BY DEFAULT, AND EMPTY IS SAFE. Comma-separated IP address(es) of the
# reverse-proxy peers in front of this API -- the address the application
# itself observes as the immediate peer, not the public hostname of a load
# balancer. If you are unsure, log `request.client.host` once and read it off.
#
# What it changes: `app/core/client_ip.py` reads `X-Forwarded-For` ONLY when
# the immediate peer is one of the addresses listed here, and takes the
# leftmost entry as the client. Empty means no proxy is trusted, so the
# forwarding header is ignored entirely and the socket address is used.
#
# NEVER list an address you do not control, and never a wildcard or a range.
# `X-Forwarded-For` is caller-supplied text: trusting an untrusted hop lets a
# signer write their own IP into their own signature record.
#
# Why it matters beyond logging: this address is written into the agreement
# audit log and printed on the evidence certificate as the signer's origin.
# Behind an UNCONFIGURED proxy the application cannot establish the client's
# address, so it records nothing and the certificate says "origin not
# recorded" -- true, but weaker evidence than the system can produce, on every
# document.
#
# After changing this in a deployment the application must be RESTARTED or
# RELOADED; it is read at startup.
#
# Verification is not complete until a real agreement has been executed in the
# target environment and the downloaded certificate shows the CLIENT's IP
# beside each signature -- not the proxy's, and not "origin not recorded". A
# proxy address printed as a signer's origin is a false statement about a real
# person, which is the failure D8 exists to prevent. See the deployment
# checklist and MERGE_CHECKLIST in AGREEMENTS_REMEDIATION_PLAN.md.
TRUSTED_PROXIES=

# ── Signature encryption (AES-256-GCM) ───────────────────────────────────────
# REQUIRED BEFORE ANY SIGNATURE CAN BE STORED. With this unset, signing refuses
# (SignatureKeyMissing) rather than falling back to clear text -- the failure
# mode is a refused signature, never a silently unencrypted one.
#
# Generate 32 random bytes, base64-encoded:
#     python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# SEPARATE FROM `ENCRYPTION_KEY`, and it must not be the same value. That key is
# Fernet's and protects CNICs; one compromised key must not expose identity
# documents and signatures together, and rotating for one must not force
# rotation for the other.
#
# ROTATION IS NOT AUTOMATIC. Signatures written under an old key do not
# re-encrypt themselves, so changing this value makes every existing envelope
# undecryptable and the executed-PDF render for those agreements will fail.
# Rotating is an operator procedure over production data (re-encrypt with the
# old key available), not a deployment step.
#
# Rows written BEFORE this module existed are plain strings and are still read
# as-is; nothing migrates them on deploy.
SIGNATURE_ENCRYPTION_KEY=

# ── SMTP, required for agreement invitation emails ───────────────────────────
# An invited signer has no account, so the ONLY way the product can reach them
# is email. With SMTP_USER empty, `utils/email.py:_send` declines rather than
# attempting delivery, and the send response reports
# `invitation_delivery: {emailed: false, reason: "email_not_configured"}` so the
# creator is told to pass the link on by hand instead of being shown a success
# that did not happen.
#
# The same settings carry password-reset and KYC-result emails. Leaving them
# empty silently disables all three.
#
# For Gmail, SMTP_PASSWORD is an App Password (16 characters, account must have
# 2FA on) -- a normal account password will not authenticate.
#
# FRONTEND_URL is what the invitation link is built from, so it must be the
# address a RECIPIENT can reach. `localhost:3000` in an email to someone else
# resolves to their own machine and the link is dead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@attorney.ai
